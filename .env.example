SECRET_KEY=replace-with-a-random-secret-at-least-50-characters
APP_ENV=development
ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
DATABASE_URL=postgresql://archy_api_runtime:password@localhost:5432/archy
UVICORN_WORKERS=1
DATABASE_CONNECTION_BUDGET=7
MAX_AUDIO_DURATION_SECONDS=1200
MAIL_BACKEND=file
MAIL_DIRECTORY=.local/mail
RECORDING_STORAGE_ROOT=.local/media

# Production requires HTTPS, secure cookies, verified database TLS and SMTP.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_TLS=true
# SMTP_USERNAME=
# SMTP_PASSWORD=
# MAIL_FROM=Archy <noreply@example.com>

# Enable processing only after configuring a free-tier Groq key privately.
AI_BACKEND=disabled
PROCESSING_WORKERS=0
# GROQ_API_KEY=
# PROCESSING_SEGMENT_SECONDS=300
# PROCESSING_SEGMENT_BYTES=8388608
# PROCESSING_INPUT_TOKENS=4000
# PROCESSING_OUTPUT_TOKENS=1500
# PROCESSING_SUMMARY_INTERVAL=60
# With one processing worker, DATABASE_CONNECTION_BUDGET must be at least 9.

# Enable only after seeding a separate sample database.
DEMO_ENABLED=false

# Optional social sign-in; use this application's own registrations.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# KAKAO_CLIENT_ID=
# KAKAO_CLIENT_SECRET=
# APPLE_CLIENT_ID=
# APPLE_CLIENT_SECRET=

# Toss TEST mode only, with a dedicated Fernet key for encrypted credentials.
# TOSS_CLIENT_KEY=
# TOSS_SECRET_KEY=
# TOSS_KEY_ENCRYPTION_KEY=
# TOSS_WEBHOOK_TOKEN=
