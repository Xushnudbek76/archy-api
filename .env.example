SECRET_KEY=replace-with-a-random-secret-at-least-50-characters
APP_ENV=development
ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
DATABASE_URL=postgresql://archy_api_runtime:password@localhost:5432/archy
UVICORN_WORKERS=1
DATABASE_CONNECTION_BUDGET=7
MAX_AUDIO_DURATION_SECONDS=1200
MAIL_BACKEND=file
MAIL_DIRECTORY=.local/mail
RECORDING_STORAGE_ROOT=.local/media

# Production requires HTTPS, secure cookies, verified database TLS and SMTP.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_TLS=true
# SMTP_USERNAME=
# SMTP_PASSWORD=
# MAIL_FROM=Archy <noreply@example.com>
