APP_ENV=production
SECRET_KEY=replace-with-a-random-secret-of-at-least-50-characters
DATABASE_URL=postgresql://archy_api_runtime:replace-password@database.example.com:5432/archy_demo?sslmode=verify-full&sslrootcert=/run/archy-certs/ca.pem
FRONTEND_ORIGIN=https://archy.example.com
ALLOWED_HOSTS=api.example.com,127.0.0.1,localhost
COOKIE_SECURE=true
UVICORN_WORKERS=1
DATABASE_CONNECTION_BUDGET=7
RECORDING_STORAGE_ROOT=/var/lib/archy/media
MAIL_BACKEND=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_TLS=true
SMTP_USERNAME=replace-with-private-user
SMTP_PASSWORD=replace-with-private-password
MAIL_FROM=Archy <noreply@example.com>
MAX_AUDIO_DURATION_SECONDS=1200
DEMO_ENABLED=false
AI_BACKEND=disabled
PROCESSING_WORKERS=0
